<Project Sdk="WixToolset.Sdk/5.0.2">
  <Import Project="ProductVersion.props" />

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <GameBuildDir Condition="'$(GameBuildDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../Builds/Release/Brickwave84'))</GameBuildDir>
    <InstallerAssetsDir Condition="'$(InstallerAssetsDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/obj/installer-assets'))</InstallerAssetsDir>
    <OutputPath Condition="'$(OutputPath)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../Builds/Installer'))/</OutputPath>
    <OutputName>Brickwave84-$(ProductVersion)</OutputName>
    <DefineConstants>ProductVersion=$(ProductVersion);GameBuildDir=$(GameBuildDir);InstallerAssetsDir=$(InstallerAssetsDir);InstallerProjectDir=$(MSBuildProjectDirectory)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>

  <Target Name="ValidateGameBuild" BeforeTargets="Build">
    <Error Condition="!Exists('$(GameBuildDir)/Brickwave84.exe')" Text="Brickwave player build not found at '$(GameBuildDir)/Brickwave84.exe'. Run Installer/Scripts/Build-Msi.ps1 -BuildPlayer or pass -p:GameBuildDir=&lt;built-player-folder&gt;." />
  </Target>
</Project>
